@startuml
'https://plantuml.com/class-diagram'
scale 2
skinparam classAttributeIconSize 0
skinparam classFontStyle Bold
skinparam style strictuml
hide empty members

abstract class AbstractList
abstract AbstractCollection
interface List
interface Collection

List <|-- AbstractList
Collection <|-- AbstractCollection

Collection <|- List
AbstractCollection <|- AbstractList
AbstractList <|-- ArrayList

class Animal {
-m_name : String
-m_damage : Int
-m_health : Int
-m_blood : Int
-m_bones : Int
+ <<create>> Card(n: String, d: Int, h: Int,  bl: Int, bo: Int)
+ attack(other : Card)
+ attack(player : Joueur)
+ bury()
}

class Obstacle {
-m_name : String
-m_health : Int
+ <<create>> Obstacle(n: String, h: Int)
}

class Card{
-m_type <T>
}

class Slot {
-m_content <Optional>card
}

enum TimeUnit {
DAYS
HOURS
MINUTES
}

@enduml