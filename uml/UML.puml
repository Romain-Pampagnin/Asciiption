@startuml
'https://plantuml.com/class-diagram'
scale 2
skinparam classAttributeIconSize 0
skinparam classFontStyle Bold
skinparam style strictuml
hide empty members

class Main{}


package Logique{

Main ..> Game : "   Instanciate"

Board "1  "*-->"4 \n m_slots" Card : "   contient"

Game ..> Round : "   Instanciate"
Round "1  " *--> "2  " Player : "   se joue entre"
Player "1  " *--> "1,2\nm_board, m_nextBoard" Board : "   possède"

class Round{
-m_players : Player[2]
-m_roundNumber : Integer
+<<create>> Round(playerName : String, number : Integer)
}

class Player{
-m_name : String
-m_score : Integer
-m_totalBlood : Integer
-m_cemetery : ArrayList<Card>
-m_deck : ArrayList<Card>
-m_hand : ArrayList<Card>
+<<create>> Player(name: String, deck: ArrayList<Card>) : Player
+ draw(nbCard : Integer) : Integer
+getScore() : Integer
+getBonesFromGrave() : Integer
+getHand(): ArrayList<Card>
+getDeck() : ArrayList<Card>
+getBoard() : Board
+sacrifice(index: Integer)
+playCard(handIndex: Integer, slotIndex: Integer)
+getTotalBlood() : Integer
+incrementTotalBlood(i: Integer)
+resetTotalBlood()
+decreaseTotalBlood(i: Integer)
+boardHasEmptySlot() : Boolean
+isCardPlayable(card: Card) : Boolean
+attack(other: Player)
+bury()
}

Player "1  " ..> "  m_cemetery   \n0..15" Card :"possède"
Player "1  " ..> "    m_deck   \n0..15" Card : "  possède"
Player "1  " ..> "      m_hand   \n0..15" Card : "  possède"

class CardFactory{
-<<create>> CardFactory() : CardFactory
+createChat() : Card
+createGrizzly() : Card
+createCoyote() : Card
+createMoineau() : Card
+createCorbeau() : Card
+createEcureuil() : Card
+createHermine() : Card
+createLouveteau() : Card
+createLoup() : Card
+createPunaise() : Card
+createRocher() : Card
+createSapin() : Card
}

CardFactory ..> Card : "   Instanciate"


class Card {
-m_name : String
-m_damage : Integer
-m_health : Integer
-m_blood : Integer
-m_bones : Integer
-m_flying : Boolean
- m_sacrifiable : Boolean
+ <<create>> Card(n: String, d: Integer, h: Integer,  bl: Integer, bo: Integer, fly: Boolean) : Card
+ <<create>> Card(n: String, d: Integer, h: Integer,  bl: Integer, bo: Integer, fly: Boolean, sacrifiable: Boolean) : Card
+ getName() : String
+ getHealth(): Integer
+ getAttack(): Integer
+ getBones(): Integer
+ getBlood() : Integer
+ isFlying() : Boolean
+ getExpandable() : Boolean
+ takeDamage(nbDamage: Integer)
+ attack(other: Card) : Integer
+ isDead() : Boolean
+ toString() : String
}

class Board {
+<<create>> Board(size: Integer) : Board
+getCards() : Optional<Card>[]
+addToBoard (index: Integer, card : Card)
+removeFromBoard(index: Integer)
+attack(other: Board) : Integer
+hasEmptySlot() : Boolean
+toString() : String
}

class Game{
}

}

Package Affichage{
class Display{
+{static}Hand() : String
}
}

@enduml