@startuml
'https://plantuml.com/class-diagram'
scale 2
skinparam classAttributeIconSize 0
skinparam classFontStyle Bold
skinparam style strictuml
hide empty members


Board "1  "*-->"4 \n m_slots" Slot : "   est composé de"
Slot "1  "*---> "0,1 \n m_card"Card : "   accueille"
Game ..> Round : "   Instanciate"
Round "1  " *--> "2  " Player : "   se joue entre"
Player "1  " *--> "1,2\nm_board, m_nextBoard" Board : "   possède"

class Round{
-m_players : Player[2]
-m_roundNumber : Integer
+<<create>> Round(playerName : String, number : Integer)
}

class Player{
-m_nom : String
-m_score : Integer
-m_nextBoard: Optional<Board>
-m_cemetery : ArrayList<Card>
-m_deck : ArrayList<Card>
-m_hand : ArrayList<Card>
+<<create>> Player(String : name, ArrayList<Card> deck, )
+<<create>> Player(ArrayList<Card> deck)
+ draw(nbCard : Integer) : Integer
+ playCard(nbSlot : Integer) : Boolean
+ getBonesFromGrave() : Integer
+ getHand() : ArrayList<Card>
}

class Card {
-m_name : String
-m_damage : Integer
-m_health : Integer
-m_blood : Integer
-m_bones : Integer
-m_flying : Boolean
+ <<create>> Card(String: n, d: Integer, h: Integer,  bl: Integer, bo: Integer, fly: Boolean)
+ getName() : String
+ getHealth(): Integer
+ getAttack(): Integer
+ getBones(): Integer
+ getBlood() : Integer
+ isFlying() : Boolean
+ takeDamage()
}

class Slot {
+ <<create>> Slot()
+ addCard(card : Card) : Boolean
+ removeCard() : Boolean
+ getCard(): Card (optional)
+ attack(other : Slot) : Integer
}

class Board {
-m_Slots: Slot[4]
+<<create>> Board()
+ addToSlot(nbSlot : Integer, card Card) : Boolean
+ sacrifice(index : Integer) : Boolean
+ attack (other : Board) : Integer
+ getTotalBlood() : Integer
/'+ isSlotFree(nbSlot : Integer) : Boolean '/
}

class Game{
}

@enduml