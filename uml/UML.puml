@startuml
'https://plantuml.com/class-diagram'
scale 2
skinparam classAttributeIconSize 0
skinparam classFontStyle Bold
skinparam style strictuml
hide empty members

class Main{}


package Logique{

Main ..> Game : "   Instanciate"

Board "1  "*-->"4 \n m_slots" Card : "   contient"

Game ..> Round : "   Instanciate"
Round "1  " *--> "2  " Player : "   se joue entre"


class Round{
-m_players : Player[2]
-m_roundNumber : Integer
+<<create>> Round(playerName : String, number : Integer)
}

class Player{
-m_name : String
-m_score : Integer
-m_totalBlood : Integer
-m_cemetery : ArrayList<Card>
-m_hand : ArrayList<Card>
+<<create>> Player(name: String, deck: ArrayList<Card>) : Player
+ draw(nbCard : Integer) : Integer
+getScore() : Integer
+getBonesFromGrave() : Integer
+getHand(): ArrayList<Card>
+getDeck() : ArrayList<Card>
+getBoard() : Board
+sacrifice(index: Integer)
+playCard(handIndex: Integer, slotIndex: Integer)
+getTotalBlood() : Integer
+incrementTotalBlood(i: Integer)
+resetTotalBlood()
+decreaseTotalBlood(i: Integer)
+boardHasEmptySlot() : Boolean
+isCardPlayable(card: Card) : Boolean
+attack(other: Player)
+bury()
}

Player "1  " *--> "  m_cemetery   \n0..15" Card :"possède"
Player "1  " *--> "    m_deck   \n1" Deck : "  possède"
Player "1  " *--> "1,2\nm_board, m_nextBoard" Board : "   possède"
Player "1  " *--> "      m_hand   \n0..15" Card : "  possède"

class CardFactory{
-<<create>> CardFactory() : CardFactory
+createChat() : Card
+createGrizzly() : Card
+createCoyote() : Card
+createMoineau() : Card
+createCorbeau() : Card
+createEcureuil() : Card
+createHermine() : Card
+createLouveteau() : Card
+createLoup() : Card
+createPunaise() : Card
+createRocher() : Card
+createSapin() : Card
}

CardFactory ..> Card : "   <<instanciate>>"


class Card {
-m_name : String
-m_damage : Integer
-m_health : Integer
-m_blood : Integer
-m_bones : Integer
-m_flying : Boolean
- m_sacrifiable : Boolean
+ <<create>> Card(n: String, d: Integer, h: Integer,  bl: Integer, bo: Integer, fly: Boolean) : Card
+ <<create>> Card(n: String, d: Integer, h: Integer,  bl: Integer, bo: Integer, fly: Boolean, sacrifiable: Boolean) : Card
+ getName() : String
+ getHealth(): Integer
+ getAttack(): Integer
+ getBones(): Integer
+ getBlood() : Integer
+ isFlying() : Boolean
+ getExpandable() : Boolean
+ takeDamage(nbDamage: Integer)
+ attack(other: Card) : Integer
+ isDead() : Boolean
+ toString() : String
}

class Board {
+<<create>> Board(size: Integer) : Board
+getCards() : Card[*]
+addToBoard (index: Integer, card : Card)
+removeFromBoard(index: Integer)
+attack(other: Board) : Integer
+hasEmptySlot() : Boolean
+toString() : String
}

Deck "1"*--> "          m_cards     \n0..*" Card : "contient"
Deck ..> CardFactory : <<call>>

class Deck{
+<<create>>Deck() : Deck
+<<create>>Deck(roundNumber: Integer) : Deck
-buildDeck(roundNumber: Integer) : Deck
+addCard(card: Card)
+draw(): Card
+getDeckSize(): Integer
+isDeckEmpty() : Boolean
}

class Game{
}

}

Package Affichage{
Display ..> Player : <<uses>>
Display ..> Board : <<uses>>
Display ..> Round : <<uses>>

class Display{
+{static}hand(player: Player) : String
+{static}handline(player: Player, cardIndex: Integer) : String
+{static}player(player: Player, player2: Player) : String
+{static}board(board: Board) : String
+{static}nextBoard(board: Board) : String
+{static}intro() : String
+{static}padRight(s: String, n: Integer) : String
+{static}padLeft(s: String, n: Integer) : String
+{static}global(round: Round) : String
+{static}globalDebug(round: Round) : String
}

TurnDialog "* " o--> "1" Round : "est utilisé dans"

class TurnDialog{
-{static}m_choix : Scanner
-{static}m_round : Round
+setRound(round: Round)
-{static} sleep(millisec: Integer)
+{static} actionChoices() : String
+{static} sacrifice() : Integer
+{static} askConfirm()
+{static} sacrificeError()
+{static} sacrificeOk(card: Card)
+{static} chooseCard() : Integer
+{static} chooseSlot(card: Card) : Integer
+{static} handIsEmpty()
+{static} slotIsOccupied()
+{static} cardUnplayable()
}
}

@enduml